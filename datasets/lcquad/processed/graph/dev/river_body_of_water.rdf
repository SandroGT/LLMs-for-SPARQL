</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="ontology/leaderName">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">leader name</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="ontology/sourceMountain">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">source mountain</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="property/cities">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cities</rdfs:label>
</owl:ObjectProperty>

<owl:Class rdf:about="resource/Upper_Neretva">
