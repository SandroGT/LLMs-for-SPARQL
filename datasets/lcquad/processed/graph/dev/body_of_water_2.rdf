<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://dbpedia.org/"
         xmlns="http://dbpedia.org/">

<owl:Ontology rdf:about="http://dbpedia.org"/>

<owl:ObjectProperty rdf:about="ontology/riverMouth">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">river mouth</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="property/inflow">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">inflow</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="ontology/nearestCity">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nearest city</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="property/cities">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cities</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="ontology/outflow">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">outflow</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="rdf:type">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rdf type</rdfs:label>
</owl:ObjectProperty>

<owl:Class rdf:about="resource/Duwamish_River">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Duwamish River</rdfs:label>
</owl:Class>

<owl:Class rdf:about="resource/Lake_Uniamési">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lake Uniamési</rdfs:label>
</owl:Class>

<owl:Class rdf:about="resource/North_Sea">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">North Sea</rdfs:label>
</owl:Class>

<owl:Class rdf:about="resource/Lake_Victoria">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lake Victoria</rdfs:label>
</owl:Class>


</rdf:RDF>
