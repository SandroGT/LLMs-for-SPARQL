         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://dbpedia.org/"
         xmlns="http://dbpedia.org/">

<owl:Ontology rdf:about="http://dbpedia.org"/>

<owl:ObjectProperty rdf:about="ontology/owner">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">owner</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="property/foundation">
