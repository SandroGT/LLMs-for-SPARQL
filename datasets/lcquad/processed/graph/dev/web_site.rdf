</owl:Class>

<owl:Class rdf:about="resource/Wiktionary">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Wiktionary</rdfs:label>
