  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">company</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="property/services">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">services</rdfs:label>
</owl:ObjectProperty>

