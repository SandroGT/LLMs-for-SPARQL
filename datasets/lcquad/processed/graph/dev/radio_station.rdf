  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">owner</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="property/owner">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">owner</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="rdf:type">
