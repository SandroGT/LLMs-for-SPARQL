         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://dbpedia.org/"
         xmlns="http://dbpedia.org/">

<owl:Ontology rdf:about="http://dbpedia.org"/>

<owl:ObjectProperty rdf:about="property/tenants">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tenants</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="property/location">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">location</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="ontology/officialLanguage">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">official language</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="rdf:type">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rdf type</rdfs:label>
</owl:ObjectProperty>

<owl:Class rdf:about="resource/Latin">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Latin</rdfs:label>
</owl:Class>

<owl:Class rdf:about="resource/Sovereign_Military_Order_of_Malta">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sovereign Military Order Of Malta</rdfs:label>
</owl:Class>

<owl:Class rdf:about="resource/Canada">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Canada</rdfs:label>
</owl:Class>


