<owl:ObjectProperty rdf:about="property/school">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">school</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="rdf:type">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">rdf type</rdfs:label>
</owl:ObjectProperty>

