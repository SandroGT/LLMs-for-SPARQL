</owl:ObjectProperty>

<owl:Class rdf:about="resource/Prime_Time_Entertainment_Network">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Prime Time Entertainment Network</rdfs:label>
</owl:Class>

<owl:Class rdf:about="resource/Sigma_TV">
