  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">network</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="property/presenter">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">presenter</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="property/headquarters">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">headquarters</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="ontology/channel">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">channel</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="rdf:type">
