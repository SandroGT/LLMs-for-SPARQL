         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://dbpedia.org/"
         xmlns="http://dbpedia.org/">

<owl:Ontology rdf:about="http://dbpedia.org"/>

<owl:ObjectProperty rdf:about="ontology/largestCity">
