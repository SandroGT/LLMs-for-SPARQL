<owl:Ontology rdf:about="http://valuenet/ontop"/>

<owl:ObjectProperty rdf:about="ref-channel">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="broadcast"/>
        <rdf:Description rdf:about="broadcast_share"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="channel"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
