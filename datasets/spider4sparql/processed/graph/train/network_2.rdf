      </owl:unionOf>
    </rdfs:Datatype>
  </rdfs:range>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">age</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="name">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="personfriend"/>
        <rdf:Description rdf:about="person"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
      </owl:unionOf>
    </rdfs:Datatype>
  </rdfs:range>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">name</rdfs:label>
</owl:DatatypeProperty>

