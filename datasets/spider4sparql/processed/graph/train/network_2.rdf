<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://valuenet/ontop/"
         xmlns:owlr="http://www.lesfleursdunormal.fr/static/_downloads/owlready_ontology.owl#"
         xmlns="http://valuenet/ontop/">

<owl:Ontology rdf:about="http://valuenet/ontop"/>

<owl:ObjectProperty rdf:about="ref-name">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="personfriend"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="person"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ref-name</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="ref-friend">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="personfriend"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="person"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ref-friend</rdfs:label>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="age">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
