    </owl:Class>
  </rdfs:domain>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
      </owl:unionOf>
    </rdfs:Datatype>
  </rdfs:range>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gender</rdfs:label>
