    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="bridge"/>
        <rdf:Description rdf:about="mill"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="architect"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
