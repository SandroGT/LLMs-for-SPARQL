<owl:NamedIndividual rdf:about="aircraft/aircraft_id-4">
  <rdf:type rdf:resource="aircraft"/>
  <max_disk_loading rdf:datatype="http://www.w3.org/2001/XMLSchema#string">14.5 lb/ft² (71 kg/m²)</max_disk_loading>
  <max_gross_weight rdf:datatype="http://www.w3.org/2001/XMLSchema#string">123,500 lb (56,000 kg)</max_gross_weight>
  <aircraft_id rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</aircraft_id>
  <aircraft rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mil Mi-26</aircraft>
  <total_disk_area rdf:datatype="http://www.w3.org/2001/XMLSchema#string">8,495 ft² (789 m²)</total_disk_area>
  <description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Heavy-lift helicopter</description>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="match/round-3">
  <rdf:type rdf:resource="match"/>
  <ref-winning_pilot rdf:resource="pilot/pilot_id-6"/>
  <ref-winning_aircraft rdf:resource="aircraft/aircraft_id-2"/>
  <fastest_qualifying rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hannes Arch</fastest_qualifying>
  <round rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.0</round>
  <date rdf:datatype="http://www.w3.org/2001/XMLSchema#string">May 8–9</date>
  <winning_aircraft rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</winning_aircraft>
  <winning_pilot rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</winning_pilot>
  <location rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flamengo Beach , Rio de Janeiro</location>
  <country rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Brazil</country>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="pilot/pilot_id-6">
  <rdf:type rdf:resource="pilot"/>
  <name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elisha Hickle V</name>
  <age rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">37</age>
