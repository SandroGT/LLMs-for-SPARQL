<owl:Ontology rdf:about="http://valuenet/ontop"/>

<owl:ObjectProperty rdf:about="ref-shop">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="stock"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="shop"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
