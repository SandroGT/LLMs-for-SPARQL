<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://valuenet/ontop/"
         xmlns:owlr="http://www.lesfleursdunormal.fr/static/_downloads/owlready_ontology.owl#"
         xmlns="http://valuenet/ontop/">

<owl:Ontology rdf:about="http://valuenet/ontop"/>

<owl:ObjectProperty rdf:about="ref-manufacturer">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="products"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="manufacturers"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ref-manufacturer</rdfs:label>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="founder">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="manufacturers"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
      </owl:unionOf>
    </rdfs:Datatype>
  </rdfs:range>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">founder</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="name">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="manufacturers"/>
        <rdf:Description rdf:about="products"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:domain>
  <rdfs:range>
    <rdfs:Datatype>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
      </owl:unionOf>
    </rdfs:Datatype>
  </rdfs:range>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">name</rdfs:label>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="code">
  <rdfs:domain>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="products"/>
        <rdf:Description rdf:about="manufacturers"/>
